# Local/offline Machine Connect defaults. Replace secrets before shared use.
POSTGRES_USER=mc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=machineconnect
MQTT_URL=mqtt://emqx:1883
DATABASE_URL=postgres://mc:change-me@postgres:5432/machineconnect
MQTT_TELEMETRY_TOPIC=devices/+/telemetry
PG_POOL_MAX=5
MAX_PAYLOAD_BYTES=262144
DEVICE_ID=sensor-001
PUBLISH_INTERVAL_SECONDS=5
