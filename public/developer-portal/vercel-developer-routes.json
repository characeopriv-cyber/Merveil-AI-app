          "value": "developers.junction.technology"
        }
      ],
      "destination": "/developer-portal/onboarding.html"
    },
    {
      "source": "/onboarding/",
      "has": [
        {
          "type": "host",
          "value": "developers.junction.technology"
        }
      ],
      "destination": "/developer-portal/onboarding.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "developers.junction.technology"
        }
      ],
      "destination": "/developer-portal/$1"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "developers.merveil.ai"
        }
      ],
      "destination": "/developer-portal/studio.html"
    },
    {
      "source": "/onboarding",
      "has": [
        {
          "type": "host",
          "value": "developers.merveil.ai"
        }
      ],
      "destination": "/developer-portal/onboarding.html"
    },
    {
      "source": "/onboarding/",
      "has": [
        {
          "type": "host",
          "value": "developers.merveil.ai"
        }
      ],
      "destination": "/developer-portal/onboarding.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "developers.merveil.ai"
        }
      ],
      "destination": "/developer-portal/$1"
    },
    {
      "source": "/((?!api/|assets/|favicon|sw\\.js|arena/|manifest\\.webmanifest|icons/|\\.well-known/|developer(?:/|$)|developer-portal(?:/|$)|interface(?:/|$)|admin(?:/|$)|merveil-admin-x9k2(?:/|$)|onboarding(?:/|$)|oauth(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/developer-portal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/developer-portal/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dev",
      "destination": "/developer",
      "permanent": false
    }
  ]
