{
  "rewrites": [
    { "source": "/api/engine/generate", "destination": "/api/engine-generate" },
    { "source": "/api/engine/(.*)", "destination": "/api/engine" },
    { "source": "/api/engine", "destination": "/api/engine" },
    { "source": "/api/developer-home", "destination": "/api/studio?action=home" },
    { "source": "/api/build-check", "destination": "/api/v1?route=build-check" },
    { "source": "/api/debug", "destination": "/api/v1?route=debug" },
    { "source": "/api/developer-project", "destination": "/api/v1?route=developer-project" },
    { "source": "/api/developer-project-files", "destination": "/api/v1?route=developer-project-files" },
    { "source": "/api/developer-debug-project", "destination": "/api/v1?route=developer-debug-project" },
    { "source": "/api/developer-builds", "destination": "/api/v1?route=developer-builds" },
    { "source": "/api/developer-build-history", "destination": "/api/v1?route=developer-build-history" },
    { "source": "/api/developer-project-context", "destination": "/api/v1?route=developer-project-context" },
    { "source": "/api/developer-sandbox-build", "destination": "/api/v1?route=developer-sandbox-build" },
    { "source": "/api/developer-git", "destination": "/api/v1?route=developer-git" },
    { "source": "/api/developer-health", "destination": "/api/v1?route=developer-health" },
    { "source": "/api/github-oauth", "destination": "/api/v1?route=github-oauth" },
    { "source": "/api/github-repos", "destination": "/api/v1?route=github-repos" },
    { "source": "/api/session", "destination": "/api/router" },
    { "source": "/api/security-gate", "destination": "/api/router" },
    { "source": "/invite", "destination": "/api/share?type=invite" },
    { "source": "/invite/", "destination": "/api/share?type=invite" },
    { "source": "/interface/(.*)", "destination": "/interface/$1" },
    { "source": "/interface/", "destination": "/interface/index.html" },
    { "source": "/interface", "destination": "/interface/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/(.*)", "destination": "/admin/$1" },
    { "source": "/merveil-admin-x9k2", "destination": "/admin/index.html" },
    { "source": "/merveil-admin-x9k2/(.*)", "destination": "/admin/index.html" },
    { "source": "/developer/workflows/", "destination": "/developer-portal/workflows.html" },
    { "source": "/developer/workflows", "destination": "/developer-portal/workflows.html" },
    { "source": "/developer/agents/", "destination": "/developer-portal/agents.html" },
    { "source": "/developer/agents", "destination": "/developer-portal/agents.html" },
    { "source": "/api/v1/(.*)", "destination": "/api/v1?route=$1" },
    { "source": "/api/v1", "destination": "/api/v1?route=health" },
    { "source": "/developer", "destination": "/developer-portal/studio.html" },
    { "source": "/developer/", "destination": "/developer-portal/studio.html" },
    { "source": "/developer/pro", "destination": "/developer-portal/pro.html" },
    { "source": "/developer/pro/", "destination": "/developer-portal/pro.html" },
    { "source": "/developer/classic", "destination": "/developer-portal/console.html" },
    { "source": "/developer/classic/", "destination": "/developer-portal/console.html" },
    { "source": "/developer/studio", "destination": "/developer-portal/studio.html" },
    { "source": "/developer/studio/", "destination": "/developer-portal/studio.html" },
    { "source": "/developer/onboarding", "destination": "/developer-portal/onboarding.html" },
    { "source": "/developer/onboarding/", "destination": "/developer-portal/onboarding.html" },
    { "source": "/developer/quickstart", "destination": "/developer-portal/quickstart.html" },
    { "source": "/developer/quickstart/", "destination": "/developer-portal/quickstart.html" },
    { "source": "/oauth/consent", "destination": "/developer-portal/oauth-consent.html" },
    { "source": "/oauth/consent/", "destination": "/developer-portal/oauth-consent.html" },
    { "source": "/dev", "destination": "/developer" },
    { "source": "/onboarding", "destination": "/developer-portal/onboarding.html" },
    { "source": "/onboarding/", "destination": "/developer-portal/onboarding.html" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "developer.junction.technology" }], "destination": "/developer-portal/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "developers.junction.technology" }], "destination": "/developer-portal/$1" },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "developers.merveil.ai" }], "destination": "/developer-portal/$1" },
    { "source": "/api/(.*)", "destination": "/api/router" },
    { "source": "/((?!api/|assets/|favicon|sw\\.js|arena/|manifest\\.webmanifest|icons/|\\.well-known/|developer(?:/|$)|developer-portal(?:/|$)|interface(?:/|$)|admin(?:/|$)|merveil-admin-x9k2(?:/|$)|onboarding(?:/|$)|oauth(?:/|$)).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/engine.js": { "maxDuration": 60, "memory": 1024 },
    "api/engine-generate.js": { "maxDuration": 60, "memory": 1024 },
    "api/studio.js": { "maxDuration": 30, "memory": 512 },
    "api/router.js": { "maxDuration": 30 },
    "api/v1.js": { "maxDuration": 60, "memory": 1024 }
  },
  "headers": [
    { "source": "/api/v1/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/api/(engine|engine-generate|studio|debug|build-check|developer.*|github.*)(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" }, { "key": "Pragma", "value": "no-cache" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/developer-portal/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }, { "key": "X-Frame-Options", "value": "SAMEORIGIN" }] },
    { "source": "/developer-portal/config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "developer.junction.technology" }], "destination": "https://www.junction.technology/developer", "permanent": false },
    { "source": "/dev", "destination": "/developer", "permanent": false },
    { "source": "/pro", "destination": "/developer/pro", "permanent": false }
  ]
}
