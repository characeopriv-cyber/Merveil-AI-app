          "value": "developers.merveil.ai"
        }
      ],
      "destination": "/developer-portal/onboarding.html"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "developers.merveil.ai"
        }
      ],
      "destination": "/developer-portal/$1"
    },
    {
      "source": "/invite",
      "destination": "/api/router?resource=share&type=invite"
    },
    {
      "source": "/invite/",
      "destination": "/api/router?resource=share&type=invite"
    },
    {
      "source": "/api/v1/(.*)",
      "destination": "/api/router?resource=v1&route=$1"
    },
    {
      "source": "/api/v1",
      "destination": "/api/router?resource=v1&route=health"
    },
    {
      "source": "/api/webhooks/(.*)",
      "destination": "/api/router?resource=webhooks&hook=$1"
    },
    {
      "source": "/api/studio/(.*)",
      "destination": "/api/router?resource=studio&path=$1"
    },
    {
      "source": "/api/engine/(.*)",
      "destination": "/api/router?resource=engine&path=$1"
    },
    {
      "source": "/api/enrich",
      "destination": "/api/router?resource=enrich"
    },
    {
      "source": "/api/enrich/",
      "destination": "/api/router?resource=enrich"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/router"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,PUT,PATCH,DELETE,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Requested-With, Accept, Origin, X-Merveil-Client"
        },
        {
          "key": "Access-Control-Max-Age",
          "value": "86400"
        }
      ]
    },
    {
      "source": "/api/v1/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/developer-portal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/developer-portal/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/dev",
      "destination": "/developer",
      "permanent": false
    },
    {
      "source": "/pro",
      "destination": "/developer/pro",
      "permanent": false
    }
  ]
}
