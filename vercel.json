    { "source": "/merveil-admin-x9k2", "destination": "/admin/index.html" },
    { "source": "/merveil-admin-x9k2/(.*)", "destination": "/admin/index.html" },
    { "source": "/developer", "destination": "/developer-portal/home.html" },
    { "source": "/developer/", "destination": "/developer-portal/home.html" },
    { "source": "/developer/beginner", "destination": "/developer-portal/beginner.html" },
    { "source": "/developer/beginner/", "destination": "/developer-portal/beginner.html" },
    { "source": "/developer/pro", "destination": "/developer-portal/pro-studio.html" },
    { "source": "/developer/pro/", "destination": "/developer-portal/pro-studio.html" },
    { "source": "/developer/studio", "destination": "/developer-portal/pro-studio.html" },
    { "source": "/developer/studio/", "destination": "/developer-portal/pro-studio.html" },
    { "source": "/developer/debug", "destination": "/developer-portal/debug.html" },
    { "source": "/developer/debug/", "destination": "/developer-portal/debug.html" },
    { "source": "/developer/boost", "destination": "/developer-portal/boost.html" },
    { "source": "/developer/boost/", "destination": "/developer-portal/boost.html" },
    { "source": "/developer/classic", "destination": "/developer-portal/console.html" },
    { "source": "/developer/classic/", "destination": "/developer-portal/console.html" },
    { "source": "/developer/workflows", "destination": "/developer-portal/workflows.html" },
    { "source": "/developer/workflows/", "destination": "/developer-portal/workflows.html" },
    { "source": "/developer/agents", "destination": "/developer-portal/agents.html" },
    { "source": "/developer/agents/", "destination": "/developer-portal/agents.html" },
    { "source": "/developer/onboarding", "destination": "/developer-portal/onboarding.html" },
    { "source": "/developer/onboarding/", "destination": "/developer-portal/onboarding.html" },
    { "source": "/developer/quickstart", "destination": "/developer-portal/quickstart.html" },
    { "source": "/developer/quickstart/", "destination": "/developer-portal/quickstart.html" },
    { "source": "/oauth/consent", "destination": "/developer-portal/oauth-consent.html" },
    { "source": "/oauth/consent/", "destination": "/developer-portal/oauth-consent.html" },
    { "source": "/dev", "destination": "/developer" },
    { "source": "/onboarding", "destination": "/developer-portal/onboarding.html" },
    { "source": "/onboarding/", "destination": "/developer-portal/onboarding.html" },
    { "source": "/api/v1/(.*)", "destination": "/api/v1?route=$1" },
    { "source": "/api/v1", "destination": "/api/v1?route=health" },
    { "source": "/api/dev/(.*)", "destination": "/api/dev/$1" },
    { "source": "/api/engine/(.*)", "destination": "/api/engine/$1" },
    { "source": "/api/studio/(.*)", "destination": "/api/studio/$1" },
    { "source": "/api/enrich", "destination": "/api/enrich" },
    { "source": "/api/enrich/", "destination": "/api/enrich" },
    { "source": "/api/(.*)", "destination": "/api/router" },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "developer.junction.technology" }],
      "destination": "/developer-portal/home.html"
    },
    {
      "source": "/onboarding",
      "has": [{ "type": "host", "value": "developer.junction.technology" }],
      "destination": "/developer-portal/onboarding.html"
    },
    {
      "source": "/onboarding/",
      "has": [{ "type": "host", "value": "developer.junction.technology" }],
      "destination": "/developer-portal/onboarding.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "developer.junction.technology" }],
      "destination": "/developer-portal/$1"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "developers.junction.technology" }],
      "destination": "/developer-portal/home.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "developers.junction.technology" }],
      "destination": "/developer-portal/$1"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "developers.merveil.ai" }],
      "destination": "/developer-portal/home.html"
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "developers.merveil.ai" }],
      "destination": "/developer-portal/$1"
    }
  ],
  "headers": [
    { "source": "/api/v1/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/.well-known/assetlinks.json", "headers": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }, { "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }, { "key": "Service-Worker-Allowed", "value": "/" }] },
    { "source": "/developer-portal/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }, { "key": "X-Frame-Options", "value": "SAMEORIGIN" }] },
    { "source": "/developer-portal/config.js", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "redirects": [
    { "source": "/dev", "destination": "/developer", "permanent": false },
    { "source": "/pro", "destination": "/developer/pro", "permanent": false }
  ]
}
